# Convex URL for Python backend to communicate with Convex DB
# In production, this should be your live Convex deployment URL (e.g., https://happy-animal-123.convex.cloud)
CONVEX_URL=https://<your-convex-deployment-name>.convex.cloud

# URL of the frontend application for CORS configuration
FRONTEND_URL=https://your-frontend-domain.com

# (Optional) If you want FastAPI to independently verify Clerk tokens without Convex, you can add Clerk config here.
# Currently, FastAPI relies on Convex to verify the token via auth:getIdentity.
# CLERK_SECRET_KEY=sk_test_...
